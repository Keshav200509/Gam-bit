# Gambit Environment Variables
# Client variables must start with VITE_
VITE_APP_NAME="Gambit"

# Supabase (optional). Leave blank to run fully offline.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Serverless score verification (/api/submit-score). Server-side only — never
# prefix the service role key with VITE_, or it would ship in the client bundle.
# SUPABASE_URL is optional; the route falls back to VITE_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
